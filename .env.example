# Optional. Copy to .env only if you want to override defaults. run.sh works
# with no .env at all. .env is gitignored — never commit real values.

# Stable proxy key. If unset, run.sh generates a throwaway one each start.
LITELLM_MASTER_KEY=

# Port the gateway listens on.
PORT=4000

# Where Copilot tokens are cached (outside the repo).
GITHUB_COPILOT_TOKEN_DIR=$HOME/.config/litellm/github_copilot

# --- GHE.com / data residency only (leave commented for github.com) ---
# GITHUB_COPILOT_API_BASE=https://copilot-api.my-company.ghe.com
# GITHUB_COPILOT_DEVICE_CODE_URL=https://my-company.ghe.com/login/device/code
# GITHUB_COPILOT_ACCESS_TOKEN_URL=https://my-company.ghe.com/login/oauth/access_token
# GITHUB_COPILOT_API_KEY_URL=https://my-company.ghe.com/api/v3/copilot_internal/v2/token
